<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Minimal bridge theme for a pure Compose app (no AppCompat / Material needed) -->
    <style name="Theme.Dreamin" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Dreamin.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Dreamin</item>
    </style>
</resources>
